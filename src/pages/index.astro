---
import Base from '../layouts/Base.astro';
import { GAMES } from '../data/games';
import { SITE } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title="Juegos" description={`Juegos de ${SITE.author}.`}>
	<h1>Hola, soy {SITE.author}</h1>
	<p class="lead">
		Desarrollo juegos con Godot. Hago juegos sencillos de jugar en ratos libres, pensados para el móvil:
		pocos controles y partidas cortas. Tienen anuncios, que se pueden quitar con una compra.
	</p>

	<h2>Mis juegos</h2>
	{GAMES.map((game) => (
		<section class="card">
			<h2>{game.name}</h2>
			<p>{game.tagline}</p>
			<a class="button" href={`${base}juegos/${game.slug}/`}>Ver el juego</a>
		</section>
	))}
</Base>
