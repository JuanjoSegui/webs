---
import { SITE } from '../data/site';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<title>{title} · {SITE.author}</title>
		<style>
			:root {
				--bg: #f7f7f5;
				--fg: #1d1d1f;
				--muted: #5c5c63;
				--card: #ffffff;
				--line: #e2e2de;
				--accent: #3a6fd8;
			}
			@media (prefers-color-scheme: dark) {
				:root:not([data-theme='light']) {
					--bg: #141418;
					--fg: #ececf1;
					--muted: #a4a4ad;
					--card: #1f1f26;
					--line: #34343e;
					--accent: #7aa7ff;
				}
			}
			* { box-sizing: border-box; }
			body {
				margin: 0;
				background: var(--bg);
				color: var(--fg);
				font: 16px/1.6 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
			}
			a { color: var(--accent); }
			main, header, footer {
				width: 100%;
				max-width: 760px;
				margin: 0 auto;
				padding: 0 16px;
			}
			header { padding-top: 24px; display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: baseline; justify-content: space-between; }
			header a.brand { font-weight: 700; color: var(--fg); text-decoration: none; }
			nav { display: flex; gap: 16px; flex-wrap: wrap; }
			nav a { color: var(--muted); text-decoration: none; }
			nav a:hover { color: var(--accent); }
			main { padding-top: 32px; padding-bottom: 48px; }
			h1 { font-size: clamp(1.8rem, 5vw, 2.4rem); line-height: 1.2; margin: 0 0 12px; }
			h2 { font-size: 1.35rem; margin: 40px 0 12px; }
			h3 { font-size: 1.1rem; margin: 24px 0 8px; }
			p.lead { font-size: 1.1rem; color: var(--muted); margin: 0 0 24px; }
			ul { padding-left: 20px; }
			.card {
				background: var(--card);
				border: 1px solid var(--line);
				border-radius: 12px;
				padding: 20px;
				margin: 16px 0;
			}
			.card h2 { margin-top: 0; }
			.card p:last-child { margin-bottom: 0; }
			.tag {
				display: inline-block;
				font-size: 0.85rem;
				color: var(--muted);
				border: 1px solid var(--line);
				border-radius: 999px;
				padding: 2px 10px;
				margin: 0 6px 6px 0;
			}
			.button {
				display: inline-block;
				margin-top: 12px;
				padding: 10px 18px;
				border-radius: 8px;
				background: var(--accent);
				color: #fff;
				text-decoration: none;
				font-weight: 600;
			}
			.soon { color: var(--muted); font-style: italic; margin-top: 12px; display: block; }
			footer { border-top: 1px solid var(--line); padding-top: 20px; padding-bottom: 32px; color: var(--muted); font-size: 0.9rem; }
			footer p { margin: 4px 0; }
		</style>
	</head>
	<body>
		<header>
			<a class="brand" href={base}>{SITE.author}</a>
			<nav>
				<a href={base}>Juegos</a>
				<a href={`${base}privacidad/`}>Privacidad</a>
				<a href={`${base}contacto/`}>Contacto</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer>
			<p>© {new Date().getFullYear()} {SITE.author}.</p>
			<p>Contacto: <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
		</footer>
	</body>
</html>
